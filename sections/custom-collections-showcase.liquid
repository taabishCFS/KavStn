{{ 'custom-collections-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if section.index < 3
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
-%}

<div
  class="section section--padding custom-collections-showcase color-{{ section.settings.color_scheme }}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="custom-collections-showcase__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="custom-collections-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="custom-collections-showcase__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-collections-showcase__rows">
      {%- liquid
        assign total_blocks = section.blocks.size
        assign row_open = false
      -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign position_in_row = forloop.index0 | modulo: 2
          assign row_number = forloop.index0 | divided_by: 2 | plus: 1
          assign row_parity = row_number | modulo: 2

          assign card_custom_collection = block.settings.custom_collection
          assign card_image = block.settings.custom_image
          assign card_title = block.settings.custom_title
          assign card_url = block.settings.custom_link

          if card_image == blank and card_custom_collection != blank
            assign card_image = card_custom_collection.featured_image
          endif
          if card_title == blank and card_custom_collection != blank
            assign card_title = card_custom_collection.title
          endif
          if card_url == blank and card_custom_collection != blank
            assign card_url = card_custom_collection.url
          endif

          assign card_alt = card_image.alt | default: card_title
          assign is_last_and_alone = false
          if forloop.last and position_in_row == 0
            assign is_last_and_alone = true
          endif
        -%}

        {%- if position_in_row == 0 -%}
          <div class="custom-collections-showcase__row{% if row_parity == 0 %} custom-collections-showcase__row--reverse{% endif %}{% if is_last_and_alone %} custom-collections-showcase__row--single{% endif %}">
        {%- endif -%}

        <a
          href="{{ card_url | default: '#' }}"
          class="custom-collections-showcase__card"
          {{ block.shopify_attributes }}
        >
          <div class="custom-collections-showcase__media media-wrapper hover-wrapper">
            {%- if card_image != blank -%}
              <img
                src="{{ card_image | image_url: width: 1600 }}"
                srcset="{{ card_image | image_url: width: 600 }} 600w, {{ card_image | image_url: width: 900 }} 900w, {{ card_image | image_url: width: 1200 }} 1200w, {{ card_image | image_url: width: 1600 }} 1600w, {{ card_image | image_url: width: 2000 }} 2000w"
                sizes="(min-width: 768px) 50vw, 100vw"
                alt="{{ card_alt }}"
                loading="{{ loading }}"
                fetchpriority="{{ fetchpriority }}"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
                class="hover-scale-up"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full hover-scale-up' }}
            {%- endif -%}

            <div class="custom-collections-showcase__overlay"></div>

            {%- if card_title != blank -%}
              <div class="custom-collections-showcase__caption">
                <span class="custom-collections-showcase__title">{{ card_title }}</span>
              </div>
            {%- endif -%}
          </div>
        </a>

        {%- if position_in_row == 1 or forloop.last -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Custom Collection",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Range"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Stone furniture and architectural pieces for every interior.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Custom attributes"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "custom-collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "paragraph",
          "content": "Cards pair up two per row. Odd rows (1, 3, 5...) show a wide card on the left, narrow on the right. Even rows (2, 4, 6...) flip: narrow left, wide right. An odd number of cards leaves the last one full-width."
        },
        {
          "type": "text",
          "id": "number_label",
          "label": "Number label",
          "default": "01"
        },
        {
          "type": "collection",
          "id": "custom_collection",
          "label": "Collection",
          "info": "Optional — auto-fills image, title, and link below if left blank in those fields."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image",
          "info": "Overrides the collection's featured image."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title",
          "info": "Overrides the collection title."
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom link",
          "info": "Overrides the collection link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Showcase",
      "blocks": [
        {
          "type": "custom-collection",
          "settings": { "number_label": "01", "custom_title": "Bespoke" }
        },
        {
          "type": "custom-collection",
          "settings": { "number_label": "02", "custom_title": "Coffee Tables" }
        },
        {
          "type": "custom-collection",
          "settings": { "number_label": "03", "custom_title": "Dining Tables" }
        },
        {
          "type": "custom-collection",
          "settings": { "number_label": "04", "custom_title": "Console Tables" }
        },
        {
          "type": "custom-collection",
          "settings": { "number_label": "05", "custom_title": "Chairs" }
        }
      ]
    }
  ]
}
{% endschema %}
